{
  "name": "capstone-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "mock": "node mock/server.mjs",
    "preview": "vite preview",
    "gen:api": "openapi-typescript \"${DOCS_CONTRACT_PATH:-../capstone_docs/api/openapi.yaml}\" -o src/api/schema.gen.ts --default-non-nullable false",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:prism": "prism mock \"${DOCS_CONTRACT_PATH:-../capstone_docs/api/openapi.yaml}\" -p 4010"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/markdown": "^1.7.2",
    "@tanstack/react-query": "^5.104.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
